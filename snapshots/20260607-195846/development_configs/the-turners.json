{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "atl-dev-the-turners",
  "initial_state": "running",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "max_open_trades": 18,
  "stake_currency": "USDC",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 1.0,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "fiat_display_currency": "USD",
  "cancel_open_orders_on_exit": false,
  "download_trades": false,
  "timeframe": "5m",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "swap",
        "defaultSettle": "USDC"
      }
    },
    "pair_whitelist": [],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "MarketCapPairList",
      "number_assets": 20,
      "max_rank": 50,
      "refresh_period": 86400
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 18084,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "[redacted]",
    "ws_token": "[redacted]",
    "CORS_origins": [],
    "username": "dev_the-turners",
    "password": "[redacted]"
  },
  "telegram": {
    "enabled": false,
    "token": "[redacted]",
    "chat_id": ""
  },
  "internals": {
    "process_throttle_secs": 5
  }
}
